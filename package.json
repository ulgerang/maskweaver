{
  "name": "maskweaver",
  "version": "0.7.34",
  "description": "AI Expert Persona System - Give your AI coding assistant expert personalities (가면술사)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maskweaver": "./dist/cli/install.js"
  },
  "files": [
    "dist",
    "masks",
    "assets"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/install.js",
      "require": "./dist/cli/install.js",
      "default": "./dist/cli/install.js"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.js",
      "default": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./context": {
      "import": "./dist/context/index.js",
      "require": "./dist/context/index.js",
      "default": "./dist/context/index.js",
      "types": "./dist/context/index.d.ts"
    },
    "./retrospect": {
      "import": "./dist/retrospect/index.js",
      "require": "./dist/retrospect/index.js",
      "default": "./dist/retrospect/index.js",
      "types": "./dist/retrospect/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify/index.js",
      "require": "./dist/verify/index.js",
      "default": "./dist/verify/index.js",
      "types": "./dist/verify/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib.js",
      "default": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./weave": {
      "import": "./dist/weave/index.js",
      "require": "./dist/weave/index.js",
      "default": "./dist/weave/index.js",
      "types": "./dist/weave/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "persona",
    "mask",
    "expert",
    "maskweaver",
    "cli",
    "embedding",
    "memory",
    "context",
    "retrospect"
  ],
  "author": "ULJI SOFT <ulgerang@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulgerang/maskweaver.git"
  },
  "homepage": "https://github.com/ulgerang/maskweaver#readme",
  "bugs": {
    "url": "https://github.com/ulgerang/maskweaver/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "commander": "^12.0.0",
    "file-uri-to-path": "^2.0.0",
    "jsonc-parser": "^3.2.0",
    "sql.js": "^1.13.0",
    "yaml": "^2.3.0",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.59",
    "@opencode-ai/sdk": "^1.1.48",
    "@rollup/rollup-win32-x64-msvc": "^4.57.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.6.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.6.0"
  }
}
