# Embedding Provider API Keys
# Copy this file to .env and fill in your keys

# Voyage AI - Code-specialized embeddings
# Get your key at: https://www.voyageai.com/
VOYAGE_API_KEY=

# OpenAI - Industry standard embeddings
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter - Multi-model gateway
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://your-app.com
OPENROUTER_TITLE=YourAppName

# Ollama - Local embeddings (no key needed)
# Install: https://ollama.ai/
# No configuration required - runs locally
